{
  "name": "draft-2-eqs-site",
  "buildCommand": null,
  "installCommand": null,
  "framework": null,
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/post/(.*)",
      "destination": "/artists/",
      "permanent": true
    },
    {
      "source": "/blog/(.*)",
      "destination": "/newsletter/",
      "permanent": true
    },
    {
      "source": "/blog(/?)",
      "destination": "/newsletter/",
      "permanent": true
    },
    {
      "source": "/artist-page/(.*)",
      "destination": "/artists/",
      "permanent": true
    },
    {
      "source": "/profile/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(eqs-artist|j-salez|tony-lozano|vinny-rivera|johandy|jhonny-evidence|laura-alcoba|ronny-mercedes|mr-don|dj-khalid|dj-tagada)(/?)",
      "destination": "/artists/",
      "permanent": true
    },
    {
      "source": "/(eqs-bookings|book-online|contact)(/?)",
      "destination": "/booking/",
      "permanent": true
    },
    {
      "source": "/(for-new-artist|submit-your-product)(/?)",
      "destination": "/apply/",
      "permanent": true
    },
    {
      "source": "/(derek-deler-photography|copy-of-derek-deler-photography)(/?)",
      "destination": "/derekvinci/",
      "permanent": true
    },
    {
      "source": "/(eqs-links-partners)(/?)",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/(under-constrution)(/?)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
